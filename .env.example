# URL direta do stream de áudio (mp3/aac).
# Zeno.fm: encontre em zeno.fm no painel da sua rádio, algo como https://stream.zeno.fm/xxxxxxxxxxxxx
# Radio.co: https://streams.radio.co/<station_id>/listen
VITE_STREAM_URL=https://stream.zeno.fm/SEU_MOUNT_AQUI

# Nome exibido no player
VITE_STATION_NAME="Rádio CBR Esperança"

# Provedor de metadados de "tocando agora": "zeno" | "radioco" | "none"
VITE_NOWPLAYING_PROVIDER=none

# Necessário se VITE_NOWPLAYING_PROVIDER=zeno (o ID do mount, ex: "xxxxxxxxxxxxx")
VITE_ZENO_MOUNT_ID=

# Necessário se VITE_NOWPLAYING_PROVIDER=radioco (o station id do Radio.co)
VITE_RADIOCO_STATION_ID=
